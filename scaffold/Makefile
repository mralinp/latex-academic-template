# Dockerized LaTeX build -- generated by create-latex-app.
# No local LaTeX install required, only Docker.
#
#   make build     compile main.pdf
#   make watch     recompile on every save
#   make shell     open a shell inside the container
#   make help      see all targets

SHELL := /bin/bash
COMPOSE := docker compose
SERVICE := latex
MAIN := main.tex
ENGINE := pdflatex
SHELL_ESCAPE := false

ENGINE_FLAG := -pdf
ifeq ($(ENGINE),xelatex)
ENGINE_FLAG := -xelatex
endif
ifeq ($(ENGINE),lualatex)
ENGINE_FLAG := -lualatex
endif

SHELL_ESCAPE_FLAG :=
ifeq ($(SHELL_ESCAPE),true)
SHELL_ESCAPE_FLAG := -shell-escape
endif

LATEXMK_FLAGS := $(ENGINE_FLAG) -interaction=nonstopmode -halt-on-error -file-line-error -synctex=1 $(SHELL_ESCAPE_FLAG)

.PHONY: help build watch clean shell lint wordcount pull

.DEFAULT_GOAL := build

help: ## Show this help message
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

build: ## Compile MAIN to a PDF
	$(COMPOSE) run --rm $(SERVICE) latexmk $(LATEXMK_FLAGS) $(MAIN)

watch: ## Recompile automatically on every save
	$(COMPOSE) run --rm $(SERVICE) latexmk $(LATEXMK_FLAGS) -pvc $(MAIN)

clean: ## Remove build artifacts
	$(COMPOSE) run --rm $(SERVICE) latexmk -C $(MAIN)

shell: ## Open a shell inside the LaTeX container
	$(COMPOSE) run --rm $(SERVICE) bash

lint: ## Lint with chktex
	$(COMPOSE) run --rm $(SERVICE) chktex $(MAIN)

wordcount: ## Word count with texcount
	$(COMPOSE) run --rm $(SERVICE) texcount -inc $(MAIN)

pull: ## Pull/update the LaTeX Docker image
	$(COMPOSE) pull
